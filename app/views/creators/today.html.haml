- content_for :page_title, 'Creator of the day'
- content_for :header_tags do
  %meta{ name: 'robots', content: 'noindex' }/
  %link{ rel: 'canonical', href: creators_today_url }/

.stromer__hero
  %p.stromer__eyebrow= l(@today, format: :long)
  %h1 Creator <em>of the day</em>

= render 'fields', fields: @fields, current: nil

- if @entry
  = render 'card', entry: @entry, feature: true
- else
  %p.stromer__empty.creators__empty No creators have posted yet.
