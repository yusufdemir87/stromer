- content_for :page_title, 'Report a problem'
- content_for :header_tags do
  %meta{ name: 'robots', content: 'noindex' }/

.stromer__hero
  %p.stromer__eyebrow No account needed
  %h1 Report a <em>problem</em>
  %p.stromer__lead.creators__lead Tell the people who run this site about a post or a creator that is wrong, harmful or does not belong. You do not need an account and nothing about you is kept.

- if @problem
  %p.stromer__alert{ role: 'alert' }= @problem

= form_with url: report_path, method: :post, local: true, class: 'stromer__form stromer__panel' do
  - if @target.is_a?(Status)
    %p.stromer__about
      About this post by
      %strong= @target.account.display_name.presence || @target.account.username
      \:
      %q= truncate(@target.text.to_s, length: 200)
    = hidden_field_tag :status_id, @target.id
  - elsif @target
    %p.stromer__about
      About the creator
      %strong= @target.display_name.presence || @target.username
    = hidden_field_tag :username, @target.username
  - else
    .stromer__field
      = label_tag :username do
        Creator name or post number
      = text_field_tag :username, params[:username], maxlength: 100
  .stromer__field
    = label_tag :category do
      What kind of problem?
    = select_tag :category, options_for_select([['Something else', 'other'], ['Spam', 'spam'], ['Illegal content', 'legal']], @category)
  .stromer__field
    = label_tag :comment do
      What is wrong?
    = text_area_tag :comment, @comment, rows: 5, maxlength: PublicReportsController::COMMENT_MAX, required: true
  .stromer__trap.creators__trap{ aria: { hidden: true } }
    = label_tag :website do
      Leave this empty
    = text_field_tag :website, nil, tabindex: -1, autocomplete: 'off'
  %p.stromer__panel-actions
    = submit_tag 'Send report', class: 'stromer__button'
